# ── EduGest — configuration d'environnement (EXEMPLE) ────────────────────────
# Copiez ce fichier en .env puis adaptez les valeurs.
# Le vrai .env est gitigné : ne JAMAIS le committer.

# Base de données SQLite (chemin relatif au dossier prisma/)
DATABASE_URL=file:./db/custom.db

# URL publique de l'application (callbacks paiements, QR, vérification de documents)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Serveur WhatsApp (mini-service Baileys, port 3001) ───────────────────────
# URL du serveur WhatsApp telle que vue par l'app Next.js.
# En local : http://localhost:3001 — avec docker compose : http://whatsapp:3001
WHATSAPP_SERVER_URL=http://localhost:3001

# Secret partagé app ↔ serveur WhatsApp (en-tête x-api-key).
# ⚠️ OBLIGATOIRE de le changer en production.
WHATSAPP_API_KEY=edugest-wa-dev-key

# Origines autorisées (CORS) du serveur WhatsApp, séparées par des virgules.
# * = toutes origines (développement uniquement).
WHATSAPP_CORS_ORIGINS=http://localhost:3000
