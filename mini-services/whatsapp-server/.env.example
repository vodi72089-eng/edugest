# ── Serveur WhatsApp EduGest (mini-service Baileys) ──────────────────────────
# Copiez ce fichier en .env puis adaptez les valeurs (le .env est gitigné).

# Secret partagé avec l'app Next.js (en-tête x-api-key).
# ⚠️ CHANGEZ-LE en production — la valeur par défaut est une clé de développement.
WHATSAPP_API_KEY=edugest-wa-dev-key

# Origines autorisées (CORS), séparées par des virgules. * = tout (dev uniquement).
WHATSAPP_CORS_ORIGINS=http://localhost:3000

# Dossier de session Baileys (credentials WhatsApp).
# Défaut sans Docker : <racine du projet>/whatsapp-auth
# En Docker (voir Dockerfile/docker-compose) : /data/whatsapp-auth (volume)
# WHATSAPP_AUTH_DIR=/data/whatsapp-auth
