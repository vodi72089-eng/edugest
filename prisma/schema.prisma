generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model School {
  id                String   @id @default(cuid())
  name              String
  shortName         String
  email             String
  phone             String
  address           String
  city              String
  province          String
  country           String
  latitude          Float?
  longitude         Float?
  logo              String?
  coverImage        String?
  description       String?
  history           String?
  mission           String?
  establishmentYear Int?
  subscriptionTier  String   @default("FREEMIUM")
  subscriptionStatus String  @default("ACTIVE")
  maxStudents       Int      @default(100)
  isActive          Boolean  @default(true)
  averageRating     Float    @default(0)
  totalReviews      Int      @default(0)
  schoolType        String   @default("MIXTE")
  schoolCategory    String   @default("PRIVEE")
  studentCount      Int      @default(0)
  classCount        Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  users             User[]
  students          Student[]
  classes           Class[]
  schoolYears       SchoolYear[]
  comments          SchoolComment[]
  subjects          Subject[]
  communications    Communication[]
  paymentRecords    PaymentRecord[]
  homeworks         Homework[]
  schoolFees        SchoolFee[]
  notifications     Notification[]
}

model User {
  id              String   @id @default(cuid())
  email           String?  @unique
  phone           String   @unique
  password        String?
  name            String
  role            String
  schoolId        String
  isActive        Boolean  @default(true)
  lastLoginAt     DateTime?
  profileImageUrl String?
  subjectName     String?   // Course/subject the teacher teaches
  classNames      String?   // Comma-separated class names the teacher occupies
  isTitulaire     Boolean   @default(false)  // Whether teacher is homeroom (titulaire)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  school          School   @relation(fields: [schoolId], references: [id])
  students        Student[] @relation("ParentChildren")
  notifications   Notification[]
}

model Student {
  id            String    @id @default(cuid())
  matricule     String    @unique
  firstName     String
  lastName      String
  dateOfBirth   DateTime?
  gender        String?
  address       String?
  phone         String?
  photoUrl      String?
  classId       String
  parentId      String?
  schoolId      String
  schoolYearId  String
  isExcluded    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  class         Class     @relation(fields: [classId], references: [id])
  parent        User?     @relation("ParentChildren", fields: [parentId], references: [id])
  school        School    @relation(fields: [schoolId], references: [id])
  schoolYear    SchoolYear @relation(fields: [schoolYearId], references: [id])
  grades        Grade[]
  disciplineRecords DisciplineRecord[]
  blacklistEntries Blacklist[]
  greylistEntries  Greylist[]
  whitelistEntries Whitelist[]
  convocations   Convocation[]
}

model Class {
  id            String    @id @default(cuid())
  name          String
  section       String?
  level         String?
  capacity      Int       @default(40)
  schoolId      String
  schoolYearId  String
  headTeacherId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  school        School    @relation(fields: [schoolId], references: [id])
  schoolYear    SchoolYear @relation(fields: [schoolYearId], references: [id])
  students      Student[]
  grades        Grade[]
  subjects      Subject[]
  homeworks     Homework[]
  schoolFees    SchoolFee[]

  @@unique([name, schoolYearId])
}

model SchoolFee {
  id          String   @id @default(cuid())
  name        String
  amount      Float
  currency    String   @default("CDF")
  trimester   String
  classId     String
  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([classId, trimester, name])
  @@index([schoolId])
  @@index([classId])
}

model Notification {
  id          String   @id @default(cuid())
  type        String
  title       String
  message     String
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId    String?
  school      School?  @relation(fields: [schoolId], references: [id])
  relatedId   String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId, isRead])
  @@index([schoolId])
}

model SchoolYear {
  id        String    @id @default(cuid())
  label     String
  startDate DateTime?
  endDate   DateTime?
  isActive  Boolean   @default(false)
  schoolId  String
  createdAt DateTime  @default(now())

  school    School    @relation(fields: [schoolId], references: [id])
  classes   Class[]
  students  Student[]
  subjects  Subject[]
  grades    Grade[]
}

model Subject {
  id           String   @id @default(cuid())
  name         String
  code         String?
  coefficient  Int      @default(1)
  schoolId     String
  schoolYearId String
  classId      String
  createdAt    DateTime @default(now())

  school       School   @relation(fields: [schoolId], references: [id])
  schoolYear   SchoolYear @relation(fields: [schoolYearId], references: [id])
  class        Class    @relation(fields: [classId], references: [id])
  grades       Grade[]

  @@unique([name, schoolYearId])
}

model Grade {
  id           String   @id @default(cuid())
  studentId    String
  subjectId    String
  classId      String
  trimester    String
  score        Float
  comment      String?
  schoolYearId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student      Student  @relation(fields: [studentId], references: [id])
  subject      Subject  @relation(fields: [subjectId], references: [id])
  class        Class    @relation(fields: [classId], references: [id])
  schoolYear   SchoolYear @relation(fields: [schoolYearId], references: [id])

  @@unique([studentId, subjectId, trimester, schoolYearId])
}

model DisciplineRecord {
  id             String   @id @default(cuid())
  studentId      String
  type           String
  severity       String
  title          String
  description    String
  points         Int
  listType       String   @default("GREYLIST")
  status         String   @default("PENDING")
  schoolId       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  student        Student  @relation(fields: [studentId], references: [id])
}

model Blacklist {
  id        String   @id @default(cuid())
  studentId String
  schoolId  String
  reason    String
  addedAt   DateTime @default(now())
  addedBy   String

  student   Student  @relation(fields: [studentId], references: [id])
}

model Greylist {
  id        String   @id @default(cuid())
  studentId String
  schoolId  String
  reason    String
  addedAt   DateTime @default(now())
  addedBy   String

  student   Student  @relation(fields: [studentId], references: [id])
}

model Whitelist {
  id        String   @id @default(cuid())
  studentId String
  schoolId  String
  reason    String?
  addedAt   DateTime @default(now())
  addedBy   String

  student   Student  @relation(fields: [studentId], references: [id])
}

model DisciplineKeyword {
  id          String   @id @default(cuid())
  keyword     String
  listType    String   // BLACKLIST, GREYLIST, WHITELIST
  schoolId    String
  learnedFrom String?  // DisciplineRecord ID that taught this keyword
  createdAt   DateTime @default(now())

  @@unique([keyword, schoolId])
}

model SchoolComment {
  id          String   @id @default(cuid())
  schoolId    String
  authorName  String
  authorEmail String?
  rating      Int
  comment     String
  isApproved  Boolean  @default(false)
  createdAt   DateTime @default(now())

  school      School   @relation(fields: [schoolId], references: [id])
}

model Convocation {
  id          String   @id @default(cuid())
  studentId   String
  parentId    String?
  motif       String
  date        DateTime
  status      String   @default("PENDING")
  schoolId    String
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student     Student  @relation(fields: [studentId], references: [id])
}

model Communication {
  id            String   @id @default(cuid())
  senderId      String
  senderRole    String
  schoolId      String
  type          String
  title         String
  content       String
  targetType    String
  targetId      String?
  sentToApp     Boolean  @default(true)
  sentToWhatsapp Boolean @default(true)
  sentAt        DateTime @default(now())
  createdAt     DateTime @default(now())

  school        School   @relation(fields: [schoolId], references: [id])
}

model PaymentRecord {
  id             String   @id @default(cuid())
  studentId      String
  schoolId       String

  school         School   @relation(fields: [schoolId], references: [id])
  amount         Int
  paidAmount     Int      @default(0)
  trimester      String
  paymentMethod  String?
  referenceNumber String?
  status         String   @default("PENDING")
  paidAt         DateTime?
  receiptNumber  String?
  verifiedBy     String?   // Name of the verifier
  verifiedAt     DateTime? // When it was verified
  verificationNote String? // Optional note from verifier
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Homework {
  id            String   @id @default(cuid())
  title         String
  description   String   @default("")
  subjectName   String
  classId       String
  teacherName   String
  teacherId     String?   // Reference to the teacher user
  isTitulaire   Boolean  @default(false)  // Whether the teacher is titulaire
  dueDate       DateTime
  schoolId      String

  school        School   @relation(fields: [schoolId], references: [id])
  class         Class    @relation(fields: [classId], references: [id])
  isPublished   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ReportCard {
  id           String   @id @default(cuid())
  studentId    String
  trimester    String
  schoolYearId String
  average      Float?
  decision     String?
  isUnlocked   Boolean  @default(false)
  generatedAt  DateTime @default(now())
  pdfUrl       String?

  @@unique([studentId, trimester, schoolYearId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  userName   String
  userRole   String
  action     String
  entityType String
  entityId   String?
  details    String?
  createdAt  DateTime @default(now())
}

model GlobalApiConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedBy   String
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model PricingPlan {
  id          String   @id @default(cuid())
  tier        String   @unique
  name        String
  price       Int      @default(0)
  originalPrice Int?
  period      String   @default("/mois")
  description String
  features    String
  color       String   @default("")
  isPopular   Boolean  @default(false)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

// Configuration des passerelles de paiement par école
model PaymentGatewayConfig {
  id              String   @id @default(cuid())
  schoolId        String
  gatewayType    String    // DPO, STRIPE, PAYPAL, FLUTTERWAVE, MPESA, ORANGE_MONEY, AIRTEL_MONEY, MANUAL
  isActive       Boolean   @default(false)
  isTestMode     Boolean   @default(true)

  // Identifiants API (chiffrés côté serveur)
  merchantId     String?
  apiKey         String?
  secretKey      String?
  publicKey      String?
  webhookSecret  String?

  // Configuration spécifique
  phoneNumber    String?   // Pour Mobile Money
  accountEmail   String?   // Pour PayPal/Stripe

  // Monnaie supportée par cette passerelle
  currency       String   @default("USD")

  // Frais de transaction (en pourcentage)
  feePercent     Float    @default(0)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([schoolId, gatewayType])
}

// Configuration de la monnaie par école
model SchoolCurrencyConfig {
  id              String   @id @default(cuid())
  schoolId        String   @unique
  baseCurrency    String   @default("USD")    // Monnaie de base de l'école
  displayCurrency String   @default("USD")    // Monnaie d'affichage
  enabledCurrencies String @default("USD,EUR,CDF") // Monnaies acceptées

  // Taux de change manuels (optionnel, sinon utilise l'API open source)
  manualRates     String?  // JSON: {"USD":1,"EUR":0.92,"CDF":2500}
  useManualRates  Boolean  @default(false)

  // Dernière mise à jour automatique des taux
  lastRateUpdate  DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Taux de change (historique pour audit)
model ExchangeRate {
  id          String   @id @default(cuid())
  base        String   // Monnaie de base (ex: USD)
  target      String   // Monnaie cible (ex: CDF)
  rate        Float    // Taux de change
  source      String   @default("exchangerate-api") // Source des données
  fetchedAt   DateTime @default(now())

  @@unique([base, target, source])
}

// Transactions de paiement (pour les passerelles externes)
model PaymentTransaction {
  id              String   @id @default(cuid())
  schoolId        String
  paymentRecordId String?
  studentId       String?

  gatewayType    String    // DPO, STRIPE, etc.
  gatewayTransactionId String? // ID retourné par la passerelle
  reference      String    // Référence interne

  amount         Float     // Montant dans la monnaie d'origine
  currency       String    @default("USD")
  convertedAmount Float?   // Montant converti dans la monnaie de base
  baseCurrency   String?   // Monnaie de base pour la conversion

  status         String   @default("PENDING")  // PENDING, SUCCESS, FAILED, REFUNDED, CANCELLED
  paymentMethod  String?  // mobile_money, card, bank_transfer, etc.

  customerPhone  String?
  customerEmail  String?
  customerName   String?

  gatewayResponse String? // Réponse brute de la passerelle (JSON)
  errorMessage   String?

  initiatedBy    String   // ID de l'utilisateur qui a initié
  initiatedAt    DateTime @default(now())
  completedAt    DateTime?
  updatedAt      DateTime @updatedAt
}
