# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...sauf les exemples de configuration, versionnés
!.env.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/

# Database
/db/

# Uploads
/upload/

# Agent context
/agent-ctx/

# Examples
/examples/

# Download
/download/

# Mini services — source is versioned, runtime artifacts are not
/mini-services/*/node_modules/
/mini-services/*/.env*
!/mini-services/whatsapp-server/.env.example
/mini-services/*/db/
/mini-services/*/.sessions/

# Environment build scripts (sandbox tooling, not app code)
/tests/
.zscripts/dev.pid

# Verification screenshots (agent tooling)
/update-verified.png
/verify-*.png
# Caddyfile
Caddyfile
tool-results/

# Uploaded files (runtime-generated user content: profile photos, student photos, etc.)
/public/uploads/

# WhatsApp session (linked phone credentials)
whatsapp-auth/
.wwebjs_auth/
.wwebjs_cache/

# Sessions
.sessions/

# Sandbox runtime build scripts
.zscripts/database-runtime-build.sh
.zscripts/python-runtime-build.sh

# Bases SQLite de test (résidus de résolution relative CLI — la vraie DB est db/custom.db)
prisma/db/*.db
.codegraph/
