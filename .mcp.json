{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest"],
      "env": {}
    },
    "memory-bank": {
      "command": "npx",
      "args": ["memory-bank-mcp", "serve", "--path", "."]
    },
    "semgrep": {
      "command": "/home/z/.semgrep-mcp-venv/bin/semgrep-mcp",
      "args": ["--directory", "/home/z/my-project"]
    },
    "codev": {
      "command": "/home/z/.npm-global/bin/codevhub",
      "args": ["serve"]
    },
    "hexstrike": {
      "command": "/home/z/.venv/bin/python3",
      "args": ["/home/z/hexstrike-ai/hexstrike_mcp.py", "--server-url", "http://127.0.0.1:8888"],
      "env": {}
    }
  }
}
