{
  "mcpServers": {
    "afrotools": {
      "type": "http",
      "url": "https://mcp.afro.tools"
    },
    "memory-bank": {
      "command": "npx",
      "args": ["memory-bank-mcp", "serve", "--path", "."]
    },
    "firecrawl": {
      "command": "npx",
      "args": ["-y", "firecrawl-mcp"],
      "env": {
        "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY}"
      }
    },
    "task-master": {
      "command": "npx",
      "args": ["-y", "--package=task-master-ai", "task-master-ai"]
    },
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest"],
      "env": {}
    },
    "semgrep": {
      "type": "stdio",
      "command": "uvx",
      "args": ["semgrep-mcp"]
    },
    "codegraph": {
      "type": "stdio",
      "command": "./node_modules/@colbymchenry/codegraph-linux-x64/bin/codegraph",
      "args": ["serve", "--mcp"]
    }
  }
}
